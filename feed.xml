---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>Dominic Orchard — Blog</title>
  <link href="https://dorchard.github.io/feed.xml" rel="self"/>
  <link href="https://dorchard.github.io/blog.html"/>
  <id>https://dorchard.github.io/feed.xml</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>Dominic Orchard</name></author>
  {% assign posts = site.blog | sort: "date" | reverse %}
  {% for post in posts limit: 20 %}
  <entry>
    <title>{{ post.title | strip | xml_escape }}</title>
    <link href="https://dorchard.github.io{{ post.url }}"/>
    <id>https://dorchard.github.io{{ post.url }}</id>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    {% for category in post.categories %}<category term="{{ category | xml_escape }}"/>
    {% endfor %}<summary>{{ post.excerpt | strip_html | strip | xml_escape }}</summary>
    <content type="html">{{ post.content | xml_escape }}</content>
  </entry>
  {% endfor %}
</feed>
